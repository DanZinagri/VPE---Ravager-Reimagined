<?xml version="1.0" encoding="utf-8"?>

<loadFolders>
	<!-- Common holds the XML patches, shared by both versions (Alpha Animals' Ravager defs are identical in 1.6 and 1.7).
	     Mods/AbilityAI holds the Ability AI rules and is listed BEFORE Common on purpose: RimWorld applies the patch files
	     of the last-listed folder first, so the rules are added after Common's whole-def replaces, not wiped by them. -->
	<v1.6>
		<li>/</li>
		<li IfModActive="saintwacko.AbilityAI">Mods/AbilityAI</li>
		<li>Common</li>
		<li>1.6</li>
	</v1.6>
	<v1.7>
		<li>/</li>
		<li IfModActive="saintwacko.AbilityAI">Mods/AbilityAI</li>
		<li>Common</li>
		<li>1.7</li>
	</v1.7>
</loadFolders>
